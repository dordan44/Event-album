# --- Required ---
# Railway PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host:5432/snapevent"

# Public origin of the deployed app (used in QR codes & OAuth redirects)
APP_URL="https://your-app.up.railway.app"

# --- Cloudflare R2 (required in production; omit locally to use disk storage) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="snapevent-media"
# Required if the bucket was created under a jurisdiction (e.g. "eu") —
# jurisdiction buckets are unreachable via the default endpoint.
R2_JURISDICTION=""
# Optional: public bucket domain (r2.dev or custom). If unset, presigned GET URLs are used.
R2_PUBLIC_BASE_URL=""

# --- Google Drive sync (optional) ---
# OAuth 2.0 Web credentials; authorized redirect URI: {APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Payments (optional) ---
# When unset, checkout runs in test mode and events activate immediately.
# Set to "yaad" | "meshulam" | "grow" once the gateway integration is wired.
PAYMENT_PROVIDER=""

# --- Email (optional, strongly recommended in production) ---
# Resend API key (https://resend.com). When unset, emails are logged to the
# server console instead, and dashboard sign-in codes are returned in the
# API response outside production so the flow stays testable.
RESEND_API_KEY=""
# Verified sender, e.g. 'SnapEvent <hello@yourdomain.co.il>'
EMAIL_FROM=""

# --- Host dashboard sessions (required in production) ---
# Secret for signing the /dashboard login cookie. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=""
